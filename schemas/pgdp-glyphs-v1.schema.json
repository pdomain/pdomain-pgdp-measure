    "AtlasSheetInput": {
      "additionalProperties": true,
      "properties": {
        "character": {
          "maxLength": 1,
          "minLength": 1,
          "title": "Character",
          "type": "string"
        },
        "label_tier": {
          "enum": [
            "transcribed",
            "recognized"
          ],
          "title": "Label Tier",
          "type": "string"
        },
        "sheet_ordinal": {
          "minimum": 0,
          "title": "Sheet Ordinal",
          "type": "integer"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "cell_count": {
          "exclusiveMinimum": 0,
          "title": "Cell Count",
          "type": "integer"
        },
        "cell_width_px": {
          "exclusiveMinimum": 0,
          "title": "Cell Width Px",
          "type": "integer"
        },
        "cell_height_px": {
          "exclusiveMinimum": 0,
          "title": "Cell Height Px",
          "type": "integer"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Sha256",
          "type": "string"
        },
        "clipped_cell_count": {
          "default": 0,
          "minimum": 0,
          "title": "Clipped Cell Count",
          "type": "integer"
        },
        "label_style": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label Style"
        }
      },
      "required": [
        "character",
        "label_tier",
        "sheet_ordinal",
        "path",
        "cell_count",
        "cell_width_px",
        "cell_height_px",
        "sha256"
      ],
      "title": "AtlasSheetInput",
      "type": "object"
    },
